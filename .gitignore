# ===========================
# PulseID — Monorepo .gitignore
# ===========================

# --------
# Python
# --------
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.env/
.venv/
env/
venv/
ENV/

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
*.py,cover

# Mypy / type checking
.mypy_cache/
.dmypy.json
dmypy.json

# Ruff
.ruff_cache/

# --------
# Django
# --------
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
media/
staticfiles/
static_collected/

# --------
# Node / JavaScript
# --------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build output
dist/
build/
*.tsbuildinfo

# --------
# Vite
# --------
# (covered by dist/ above)

# --------
# Expo / React Native
# --------
.expo/
dist/
npm-debug.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# Metro
.metro-health-check*

# --------
# Environment / Secrets
# --------
.env
.env.*
!.env.example

# Secret files
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
*.jks

# --------
# IDE / Editor
# --------
# VS Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# JetBrains / IntelliJ / Android Studio
.idea/
*.iml
*.iws
*.ipr

# Neovim
.netrwhist
Session.vim

# --------
# OS
# --------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# --------
# Local Claude / tooling config (personal, machine-local — never commit)
# --------
.claude/
.claude/settings.local.json

# --------
# Misc
# --------
*.bak
*.tmp
*.temp
*.swp
*.swo
