# =====================================================================
# PulseID — Environment Template
# =====================================================================
#
# Copy this file to `.env` and fill in real values for local development.
# NEVER commit `.env` to the repository.
#
# All values here are PLACEHOLDERS. There are no real credentials.
# =====================================================================

# ---------------------------------------------------------------------
# Django / Backend
# ---------------------------------------------------------------------

# Django environment: dev | staging | production
DJANGO_ENV=dev

# Django secret key — generate a strong random value in production.
# NEVER use a real secret in this file. Example: `python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"`
DJANGO_SECRET_KEY=change-me

# Comma-separated list of allowed hosts (production: your real domains)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Debug mode (backend only; must be False in production)
DJANGO_DEBUG=True

# ---------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------
POSTGRES_DB=pulseid
POSTGRES_USER=pulseid
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---------------------------------------------------------------------
# Redis (cache + Celery broker)
# ---------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------
# Celery
# ---------------------------------------------------------------------
CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=${REDIS_URL}

# ---------------------------------------------------------------------
# JWT / Authentication
# ---------------------------------------------------------------------

# Access token lifetime in minutes (planned: 15–20 min)
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15

# Refresh token lifetime in days
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Algorithm (keep default)
JWT_SIGNING_ALGORITHM=HS256

# ---------------------------------------------------------------------
# Frontend / Backend URLs
# ---------------------------------------------------------------------

# Admin web app (Vite)
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WEB_APP_URL=http://localhost:5173

# Mobile app (Expo) — backend base URL reachable from devices/emulators
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# ---------------------------------------------------------------------
# CORS (backend)
# ---------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:19006

# ---------------------------------------------------------------------
# Future: Biometric service (face verification / liveness)
# Implemented in a later phase. Placeholders only.
# ---------------------------------------------------------------------
BIOMETRIC_SERVICE_URL=change-me
BIOMETRIC_SERVICE_API_KEY=change-me
BIOMETRIC_TEMPLATE_ENCRYPTION_KEY=change-me

# ---------------------------------------------------------------------
# Future: Notification service (push / in-app)
# Implemented in a later phase. Placeholders only.
# ---------------------------------------------------------------------

# Expo Push Service credentials
EXPO_ACCESS_TOKEN=change-me

# ---------------------------------------------------------------------
# Observability (future phases)
# ---------------------------------------------------------------------
SENTRY_DSN=